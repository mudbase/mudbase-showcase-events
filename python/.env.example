# ── Mudbase project ──────────────────────────────────────────────────────
# Same provisioned Mudbase project as the reference ../web app in this repo —
# see ../web/plan/build-plan.md for the collection/permission schema (local
# auth, Multi-Role with organizer/attendee, three collections below, each
# granted per the RBAC matrix — read to both roles, write scoped per role).
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=6a6d3fa9d07caabbbdfc564f
EVENTS_COLLECTION_ID=6a6d3fcad07caabbbdfc5802
BOOKINGS_COLLECTION_ID=6a6d3fcbd07caabbbdfc5819
ACTIVITY_COLLECTION_ID=6a6d3fccd07caabbbdfc582e

# ── Session cookie (server-only — never expose to the browser as JS) ───────
# Signs the itsdangerous/Starlette session cookie that holds the Mudbase JWT,
# refresh token, and user profile server-side. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=mudbase_showcase_events_session
# Set to "true" behind HTTPS in production so the session cookie is Secure.
SESSION_HTTPS_ONLY=false

# ── Demo accounts (quick sign-in buttons on /login) ─────────────────────────
# The two already-verified organizer/attendee accounts this showcase's task
# brief provides. Not a production secret — this whole app is a public demo
# and these credentials are already published in this project's own
# README/build-plan. Override for a private deployment.
DEMO_ORGANIZER_EMAIL=events.organizer.demo@gmail.com
DEMO_ATTENDEE_EMAIL=events.attendee.demo@gmail.com
DEMO_PASSWORD=DemoTest123!
