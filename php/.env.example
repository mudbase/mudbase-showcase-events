# ── Mudbase project (all required — see README "Setup") ────────────────────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
MUDBASE_EVENTS_COLLECTION_ID=
MUDBASE_BOOKINGS_COLLECTION_ID=
MUDBASE_ACTIVITY_COLLECTION_ID=

# ── Session ──────────────────────────────────────────────────────────────────
# Name of the native PHP session cookie. Change only if it collides with another
# app on the same host/port during local development.
SESSION_NAME=mudbase_showcase_events_php
