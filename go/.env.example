# ── Mudbase project (see plan/build-plan.md for the full collection/permission schema) ──
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=6a6d3fa9d07caabbbdfc564f
MUDBASE_EVENTS_COLLECTION_ID=6a6d3fcad07caabbbdfc5802
MUDBASE_BOOKINGS_COLLECTION_ID=6a6d3fcbd07caabbbdfc5819
MUDBASE_ACTIVITY_COLLECTION_ID=6a6d3fccd07caabbbdfc582e

# ── App/session config ───────────────────────────────────────────────────────
# Signs and encrypts the httpOnly session cookie holding the Mudbase JWT. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Set to "true" once this app is served over HTTPS in production - a Secure cookie is silently
# never sent over plain HTTP, which would break every page on local development.
COOKIE_SECURE=false

# Local HTTP listen port.
PORT=8080
