@model IReadOnlyList<MudbaseShowcase.Events.Models.ActivityDocument>

<div class="mt-4">
    <h2 class="h6 fw-semibold mb-3">Activity</h2>

    @if (Model.Count == 0)
    {
        <p class="text-muted small">No activity yet.</p>
    }
    else
    {
        <ul class="list-unstyled d-flex flex-column gap-2">
            @foreach (MudbaseShowcase.Events.Models.ActivityDocument entry in Model)
            {
                <li class="d-flex justify-content-between align-items-baseline gap-3 small border-bottom pb-2">
                    <span>
                        <span class="fw-semibold">@entry.ActorName</span>
                        <span class="text-muted">@ActivityLabels.Describe(entry.Action)</span>
                    </span>
                    <span class="text-muted flex-shrink-0 kanban-timestamp">@DisplayHelpers.FormatRelativeTime(entry.CreatedAt)</span>
                </li>
            }
        </ul>
    }
</div>
