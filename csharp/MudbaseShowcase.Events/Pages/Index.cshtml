@page
@model MudbaseShowcase.Events.Pages.IndexModel
@{
    ViewData["Title"] = "Upcoming events";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-semibold mb-0">Upcoming events</h1>
        <p class="text-muted small mb-0">Sorted soonest first.</p>
    </div>
    @if (Model.IsOrganizerFlag)
    {
        <a class="btn btn-brand btn-sm" asp-page="/Events/New">New event</a>
    }
</div>

@if (Model.LoadError is not null)
{
    <p class="text-danger">@Model.LoadError</p>
}
else if (Model.Events.Count == 0)
{
    <div class="border border-dashed rounded p-5 text-center text-muted">No events yet.</div>
}
else
{
    <div class="row g-3">
        @foreach (MudbaseShowcase.Events.Models.EventListItemViewModel item in Model.Events)
        {
            <div class="col-sm-6">
                <partial name="Shared/_EventCard" model="item" />
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-3 mt-4">
            @if (Model.CurrentPage > 1)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Index" asp-route-pg="@(Model.CurrentPage - 1)">&larr; Previous</a>
            }
            else
            {
                <span></span>
            }
            <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
            @if (Model.HasMore)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Index" asp-route-pg="@(Model.CurrentPage + 1)">Next &rarr;</a>
            }
            else
            {
                <span></span>
            }
        </div>
    }
}
