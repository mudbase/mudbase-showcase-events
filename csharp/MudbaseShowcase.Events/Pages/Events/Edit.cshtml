@page "/Events/{id}/Edit"
@model MudbaseShowcase.Events.Pages.Events.EditModel
@{
    ViewData["Title"] = "Edit event";
}

<div class="d-flex justify-content-center">
    <div class="w-100" style="max-width: 480px;">
        <div class="card">
            <div class="card-body">
                <h1 class="h5 fw-semibold">Edit event</h1>
                <p class="text-muted small">Changes to capacity are re-checked against existing bookings on the next booking or cancellation.</p>

                @if (Model.ErrorMessage is not null)
                {
                    <p class="text-danger small" role="alert">@Model.ErrorMessage</p>
                }

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label">Title</label>
                        <input asp-for="Input.Title" class="form-control" maxlength="200" required />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label">Description</label>
                        <textarea asp-for="Input.Description" rows="4" class="form-control" maxlength="2000"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Input.StartsAt" class="form-label">Date &amp; time</label>
                            <input asp-for="Input.StartsAt" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="Input.StartsAt" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.Capacity" class="form-label">Capacity</label>
                            <input asp-for="Input.Capacity" type="number" min="1" step="1" class="form-control" required />
                            <span asp-validation-for="Input.Capacity" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Location" class="form-label">Location</label>
                        <input asp-for="Input.Location" class="form-control" maxlength="200" required />
                        <span asp-validation-for="Input.Location" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-brand w-100">Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>
