<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      net10.0, not net8.0: this build machine only has the .NET 10 SDK/runtime installed
      (dotnet's list-runtimes output shows Microsoft.NETCore.App / Microsoft.AspNetCore.App
      10.0.10 only, no 8.0.x). A net8.0-targeted app builds fine here (NuGet restores the 8.0 reference
      packs for compilation) but fails to *run* - `dotnet run`/the apphost roll-forward policy
      does not cross major versions by default, so it exits immediately with "You must install
      or update .NET to run this application" (the same fact was verified live while building the
      sibling mudbase-showcase-kanban/csharp port - checked again here rather than assumed).
      Targeting net10.0 directly avoids that entirely. The referenced Mudbase.Sdk project itself
      still targets net8.0 - a net10.0 app can consume a net8.0 library without issue.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MudbaseShowcase.Events</RootNamespace>
    <AssemblyName>MudbaseShowcase.Events</AssemblyName>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Real Mudbase C# SDK, published at https://github.com/mudbase/mudbase-sdk (subdirectory csharp/),
      NOT on NuGet. This path assumes a sibling-clone layout:

        <parent>/
          mudbase-showcase-events/       <- this repo
          mudbase-sdk/                   <- git clone https://github.com/mudbase/mudbase-sdk.git

      See README.md "Setup" for the exact clone command.
    -->
    <ProjectReference Include="../../../mudbase-sdk/csharp/src/Mudbase.Sdk/Mudbase.Sdk.csproj" />
  </ItemGroup>

</Project>
