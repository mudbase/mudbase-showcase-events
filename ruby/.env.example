# ── Mudbase project (public — a project/collection ID is not a secret) ─────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=6a6d3fa9d07caabbbdfc564f
EVENTS_COLLECTION_ID=6a6d3fcad07caabbbdfc5802
BOOKINGS_COLLECTION_ID=6a6d3fcbd07caabbbdfc5819
ACTIVITY_COLLECTION_ID=6a6d3fccd07caabbbdfc582e

# ── Session ──────────────────────────────────────────────────────────────
# Rack::Session::Cookie holds every Mudbase-issued JWT server-side, inside an httponly,
# signed+encrypted cookie — client JS never touches it. Generate a long random value, e.g.:
# ruby -rsecurerandom -e "puts SecureRandom.hex(32)"
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────────
PORT=4568
RACK_ENV=development
